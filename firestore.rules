rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
  // Helper functie om te controleren of een gebruiker een administrator is
  function isAdministrator() {
    return request.auth != null &&
           exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator';
  }
  
  // Users collection regels
  match /users/{userId} {
    // Lezen: gebruikers kunnen hun eigen document lezen, admins kunnen alle documenten lezen
    allow read: if request.auth != null &&
                (request.auth.uid == userId || isAdministrator());
    
    // Schrijven: alleen admins kunnen gebruikersdocumenten aanmaken of bijwerken
    allow write: if isAdministrator();
  }
  
  match /visits/{visitId} {
      
      // Helper functie voor vereiste velden
      function hasRequiredFields() {
        let required = ['date', 'time', 'visitorName', 'durationMinutes', 'userId'];
        return request.resource.data.keys().hasAll(required);
      }
      
      // Helper functie voor toegestane velden (inclusief optionele)
      function hasOnlyAllowedFields() {
        let allowed = ['date', 'time', 'visitorName', 'description', 
                       'durationMinutes', 'userId', 'verified'];
        return request.resource.data.keys().hasOnly(allowed);
      }
      
      // Lezen: iedereen die is ingelogd (admins kunnen alles lezen)
      allow read: if request.auth != null;
      
      // Aanmaken: valideer data (normale gebruikers kunnen alleen eigen bezoeken aanmaken, admins kunnen alles aanmaken)
      allow create: if request.auth != null &&
                      hasRequiredFields() &&
                      hasOnlyAllowedFields() &&
                      (request.resource.data.userId == request.auth.uid || isAdministrator()) &&
                      request.resource.data.date is string &&
                      request.resource.data.time is string &&
                      request.resource.data.visitorName is string &&
                      request.resource.data.durationMinutes is number &&
                      // description is optioneel - check alleen als het bestaat
                      (!request.resource.data.keys().hasAny(['description']) || 
                       request.resource.data.description is string) &&
                      // verified is optioneel - check alleen als het bestaat
                      (!request.resource.data.keys().hasAny(['verified']) || 
                       request.resource.data.verified is bool);
      
      // Updaten: eigen data of admin kan alles updaten
      allow update: if request.auth != null &&
                      (resource.data.userId == request.auth.uid || isAdministrator()) &&
                      hasOnlyAllowedFields() &&
                      (request.resource.data.userId == resource.data.userId || isAdministrator());
      
      // Verwijderen: eigen data of admin kan alles verwijderen
      allow delete: if request.auth != null &&
                      (resource.data.userId == request.auth.uid || isAdministrator());
    }
  
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}